#!/bin/bash
spawn() {
    if command -v systemd-run >/dev/null 2>&1; then
        systemd-run --user \
            --collect \
            --quiet \
            --same-dir \
            "$@"
    else
        setsid -c "$@" >/dev/null 2>&1 </dev/null
    fi
}

display() {
    runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$runtime/$WAYLAND_DISPLAY" ]; then
        return 0
    else
        for s in "$runtime"/wayland-*; do
            [ -S "$s" ] || continue
            export WAYLAND_DISPLAY="$(basename "$s")"
            return 0
        done
        return 1
    fi
}

session() {
    if display; then
        spawn "$target" "${launcher[@]}" "$@"
    else
        cage -m last -d -s -- "$target" "${launcher[@]}" "$@" \
            >/dev/null 2>&1 </dev/null &
    fi
}

install() {
    local list="/usr/share/idun/kiosk.lst"
    local configs="/usr/share/idun/kiosk_conf.tar.zst"
    local bindir="$HOME/.local/bin"
    local self
    local count=0

    self="$(readlink -f "$0")"
    mkdir -p "$bindir"
    declare -A wanted

    #
    # Part 1: Synchronize desired links
    #
    while IFS= read -r line; do
        # Remove trailing comments
        line="${line%%#*}"

        # Trim trailing whitespace
        line="${line%"${line##*[![:space:]]}"}"

        # Skip blanks
        [ -n "$line" ] || continue

        app="${line%%:*}"
        wanted["$app"]=1
    done < "$list"

    #
    # Part 2: Remove obsolete kiosk-managed links
    #
    for link in "$bindir"/*; do
        [ -L "$link" ] || continue

        target="$(readlink -f "$link")"
        [ "$target" = "$self" ] || continue

        app="$(basename "$link")"
        if [ -z "${wanted[$app]}" ]; then
            rm -f "$link"
        fi
    done

    #
    # Part 3: Install application configuration files
    #
    if [ "$replace_config" -eq 1 ]; then
        echo "Over-writing configuration for kiosk apps."
        tar --zstd -xf "$configs" -C ~/.config
    else
        tar --skip-old-files --zstd -xf "$configs" -C ~/.config
    fi

    #
    # Part 4: Display/link available applications
    #
    printf "\n"
    printf "Available kiosk applications:\n\n"
    while IFS= read -r line; do

        # Remove trailing comments
        line="${line%%#*}"

        # Trim trailing whitespace
        line="${line%"${line##*[![:space:]]}"}"

        # Skip blanks
        [ -n "$line" ] || continue

        app="${line%%:*}"
        if [[ "$line" == *:* ]]; then
            pkg="${line#*:}"
        else
            pkg="$app"
        fi

        # Determine the package manager
        if command -v apk >/dev/null 2>&1; then
            pkg_mgr="apk"
        elif command -v pacman >/dev/null 2>&1; then
            pkg_mgr="pacman"
        else
            pkg_mgr="unknown"
            echo "Warning: No supported package manager (apk/pacman) found."
        fi

        # Fetch description based on the active package manager
        desc=""
        if [ "$pkg_mgr" = "apk" ]; then
            desc="$(apk info --installed -d "$pkg" 2>/dev/null | sed -n '2p')"
        elif [ "$pkg_mgr" = "pacman" ]; then
            desc="$(pacman -Qi "$pkg" 2>/dev/null | sed -n 's/^Description[[:space:]]*:[[:space:]]*//p')"
        fi
        
        if [ -n "$desc" ]; then
            ln -snf "$self" "$bindir/$app"
            printf "  %-18s %s\n" "$app" "$desc"
            count=$((count + 1))
        fi
    done < "$list"

    printf "\n%d application(s) available.\n" "$count"
}

cmd="$(basename "$0")"
if [ "$cmd" = "kiosk" ]; then
    replace_config=0
    
    # Loop through all arguments passed to the script
    for arg in "$@"; do
        if [ "$arg" = "--replace-config" ]; then
            replace_config=1
            break
        fi
    done

    install
    exit 0
fi

