#!/bin/bash

# ---------------------------------------------------------
# Global Configuration & Initialization
# ---------------------------------------------------------
KIOSK_LIST="/usr/share/idun/kiosk.lst"
KIOSK_CONFIGS="/usr/share/idun/kiosk_conf.tar.zst"
BINDIR="$HOME/.local/bin"

# Determine the package manager
if command -v apk >/dev/null 2>&1; then
    PKG_MGR="apk"
elif command -v pacman >/dev/null 2>&1; then
    PKG_MGR="pacman"
else
    PKG_MGR="unknown"
fi

# ---------------------------------------------------------
# Helper Functions
# ---------------------------------------------------------
spawn() {
    if command -v systemd-run >/dev/null 2>&1; then
        systemd-run --user \
            --collect \
            --quiet \
            --same-dir \
            "$@"
    else
        setsid -c "$@" >/dev/null 2>&1 </dev/null &
    fi
}

display() {
    runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$runtime/$WAYLAND_DISPLAY" ]; then
        return 0
    else
        for s in "$runtime"/wayland-*; do
            [ -S "$s" ] || continue
            export WAYLAND_DISPLAY="$(basename "$s")"
            return 0
        done
        return 1
    fi
}

session() {
    # Fix needed for Qt5 programs like cool-retro-term
    export QT_QPA_PLATFORM=wayland

    if display; then
        spawn "$target" "${launcher[@]}" "$@"
    else
        cage -m last -d -s -- "$target" "${launcher[@]}" "$@" \
            >/dev/null 2>&1 </dev/null &
    fi
}

is_installed() {
    local pkg="$1"
    if [ "$PKG_MGR" = "apk" ]; then
        apk info -e "$pkg" >/dev/null 2>&1
    elif [ "$PKG_MGR" = "pacman" ]; then
        pacman -Qq "$pkg" >/dev/null 2>&1
    else
        return 1
    fi
}

# ---------------------------------------------------------
# Core Kiosk Functions
# ---------------------------------------------------------
app() {
    local raw_pkg="$1"
    
    if [ -z "$raw_pkg" ]; then
        echo "Error: No package name provided."
        return 1
    fi

    if [ "$PKG_MGR" = "unknown" ]; then
        echo "Error: No supported package manager (apk/pacman) found."
        return 1
    fi

    # Strip the optional "!" prefix if it was passed so the package manager handles it properly
    local pkg="${raw_pkg#!}"

    # Check and install package
    if ! is_installed "$pkg"; then
        echo "Installing $pkg..."
        if [ "$PKG_MGR" = "apk" ]; then
            sudo apk add "$pkg"
        elif [ "$PKG_MGR" = "pacman" ]; then
            sudo pacman -S --noconfirm "$pkg"
        fi
        
        if [ $? -ne 0 ]; then
            echo "Error: Failed to install $pkg."
            return 1
        fi
    else
        echo "Package '$pkg' is already installed."
    fi

    # Add to kiosk.lst if not already present
    # We use a regex to ensure we don't partially match another app
    if ! grep -Eq "^[[:space:]]*!?${pkg}(:|[[:space:]]|$)" "$KIOSK_LIST" 2>/dev/null; then
        echo "Adding '$raw_pkg' to $KIOSK_LIST..."
        # Requires sudo as /usr/share/idun is likely root-owned
        echo "$raw_pkg" | sudo tee -a "$KIOSK_LIST" >/dev/null
    else
        echo "Package '$pkg' is already in the kiosk list."
    fi

    # Run normal install to link and print available apps
    install
}

remove() {
    local raw_app="$1"
    
    if [ -z "$raw_app" ]; then
        echo "Error: No package name provided to remove."
        return 1
    fi

    # Strip the TUI indicator if accidentally provided
    local app="${raw_app#!}"

    if grep -Eq "^[[:space:]]*!?${app}(:|[[:space:]]|$)" "$KIOSK_LIST" 2>/dev/null; then
        echo "Removing '$app' from $KIOSK_LIST..."
        # Safely delete the line whether it has a ! prefix or not
        sudo sed -i "/^[[:space:]]*${app}\(:\|$\|[[:space:]]\)/d; /^[[:space:]]*!${app}\(:\|$\|[[:space:]]\)/d" "$KIOSK_LIST"
    else
        echo "Package '$app' is not found in the kiosk list."
    fi

    # Refresh symlinks and display list
    install
}

install() {
    local self
    local count=0

    self="$(readlink -f "$0")"
    mkdir -p "$BINDIR"
    declare -A wanted

    #
    # Part 1: Synchronize desired links
    #
    while IFS= read -r line; do
        line="${line%%#*}"
        line="${line%"${line##*[![:space:]]}"}" # Trim trailing space
        line="${line#"${line%%[![:space:]]*}"}" # Trim leading space
        [ -n "$line" ] || continue

        local clean_line="${line#!}"
        app="${clean_line%%:*}"
        wanted["$app"]=1
    done < "$KIOSK_LIST"

    #
    # Part 2: Remove obsolete kiosk-managed links
    #
    for link in "$BINDIR"/*; do
        [ -L "$link" ] || continue

        target="$(readlink -f "$link")"
        [ "$target" = "$self" ] || continue

        app="$(basename "$link")"
        if [ -z "${wanted[$app]}" ]; then
            rm -f "$link"
        fi
    done

    #
    # Part 3: Install application configuration files
    #
    if [ "$replace_config" -eq 1 ]; then
        echo "Over-writing configuration for kiosk apps."
        tar --zstd -xf "$KIOSK_CONFIGS" -C ~/.config
    else
        tar --skip-old-files --zstd -xf "$KIOSK_CONFIGS" -C ~/.config
    fi

    #
    # Part 4: Display/link available applications
    #
    printf "\nAvailable kiosk applications:\n\n"
    if [ "$PKG_MGR" = "unknown" ]; then
        echo "Warning: No supported package manager (apk/pacman) found."
    fi

    while IFS= read -r line; do
        line="${line%%#*}"
        line="${line%"${line##*[![:space:]]}"}"
        line="${line#"${line%%[![:space:]]*}"}"
        [ -n "$line" ] || continue

        local clean_line="${line#!}"
        app="${clean_line%%:*}"
        if [[ "$clean_line" == *:* ]]; then
            pkg="${clean_line#*:}"
        else
            pkg="$app"
        fi

        # Fetch description based on the active package manager
        desc=""
        if [ "$PKG_MGR" = "apk" ]; then
            desc="$(apk info --installed -d "$pkg" 2>/dev/null | sed -n '2p')"
        elif [ "$PKG_MGR" = "pacman" ]; then
            desc="$(pacman -Qi "$pkg" 2>/dev/null | sed -n 's/^Description[[:space:]]*:[[:space:]]*//p')"
        fi
        
        if [ -n "$desc" ]; then
            ln -snf "$self" "$BINDIR/$app"
            printf " %-10s %s\n" "$app" "$desc"
            count=$((count + 1))
        fi
    done < "$KIOSK_LIST"

    printf "\n%d application(s) available.\n" "$count"
}

# ---------------------------------------------------------
# Execution Entry Point
# ---------------------------------------------------------
cmd="$(basename "$0")"
if [ "$cmd" = "kiosk" ]; then
    replace_config=0
    
    # Sub-command routing
    if [ "$1" = "app" ]; then
        # Check if they request xterm wrapper behavior via sub-command syntax
        if [ "$2" = "xterm" ] && [ -n "$3" ]; then
            app "!$3"
        else
            app "$2"
        fi
        exit 0
    elif [ "$1" = "remove" ]; then
        remove "$2"
        exit 0
    fi

    # Loop through all arguments passed to the script for standard install behavior
    for arg in "$@"; do
        if [ "$arg" = "--replace-config" ]; then
            replace_config=1
            break
        fi
    done

    install
    exit 0
fi

# Fix locale setting for utf-8
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

xterm_binary=/usr/bin/foot
target="/usr/bin/$cmd"
launcher=()

# Extract the matching line from kiosk.lst to resolve aliases (e.g. thor:yazi)
line=$(grep -E "^[[:space:]]*!?${cmd}(:|[[:space:]]|$)" "$KIOSK_LIST" 2>/dev/null | head -n 1)

if [ -n "$line" ]; then
    # Strip comments and trailing whitespace
    line="${line%%#*}"
    line="${line%"${line##*[![:space:]]}"}"

    # Determine if it requires a terminal wrapper
    is_tui=0
    if [[ "$line" == [[:space:]]*\!* ]] || [[ "$line" == \!* ]]; then
        is_tui=1
    fi

    # Strip the TUI indicator and leading whitespace to parse the alias
    clean_line="${line#!}"
    clean_line="${clean_line#"${clean_line%%[![:space:]]*}"}"

    # Extract the underlying binary if an alias exists
    if [[ "$clean_line" == *:* ]]; then
        real_bin="${clean_line#*:}"
    else
        real_bin="$cmd"
    fi

    # Assign target and launcher
    if [ "$is_tui" -eq 1 ]; then
        target="$xterm_binary"
        launcher=(-e "/usr/bin/$real_bin")
    else
        target="/usr/bin/$real_bin"
    fi
elif [ "$cmd" = "xterm" ]; then
    target="$xterm_binary"
fi

session "$@"
exit 0
