xterm_binary=/usr/bin/foot
target="/usr/bin/$cmd"
launcher=()

case "$cmd" in
	xterm)
		target="$xterm_binary"
		;;

    thor)
		target="$xterm_binary"
        launcher=(-e /usr/bin/yazi)
        ;;

    ocp)
		target="$xterm_binary"
    	launcher=(-e /usr/bin/ocp)
    	;;
esac

if [ "$target" = "$xterm_binary" ]; then
    session "$@"
else
    spawn "$target" "$@"
fi

exit 0
