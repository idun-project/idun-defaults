#!/bin/bash

install() {
    local list="/usr/share/idun/kiosk.lst"
    local configs="/usr/share/idun/kiosk_conf.tar.zst"
    local bindir="$HOME/.local/bin"
    local self
    local count=0

    self="$(readlink -f "$0")"
    mkdir -p "$bindir"
    declare -A wanted

    #
    # Part 1: Synchronize desired links
    #
    while IFS= read -r line; do
        # Remove trailing comments
        line="${line%%#*}"

        # Trim trailing whitespace
        line="${line%"${line##*[![:space:]]}"}"

        # Skip blanks
        [ -n "$line" ] || continue

        app="${line%%:*}"
        wanted["$app"]=1
        ln -snf "$self" "$bindir/$app"
    done < "$list"

    #
    # Part 2: Remove obsolete kiosk-managed links
    #
    for link in "$bindir"/*; do
        [ -L "$link" ] || continue

        target="$(readlink -f "$link")"
        [ "$target" = "$self" ] || continue

        app="$(basename "$link")"
        if [ -z "${wanted[$app]}" ]; then
            rm -f "$link"
        fi
    done

    #
    # Part 3: Install application configuration files
    #
    tar --skip-old-files --zstd -xf "$configs" -C ~/.config

    #
    # Part 4: Display available applications
    #
    printf "\n"
    printf "Available kiosk applications:\n\n"
    while IFS= read -r line; do

        # Remove trailing comments
        line="${line%%#*}"

        # Trim trailing whitespace
        line="${line%"${line##*[![:space:]]}"}"

        # Skip blanks
        [ -n "$line" ] || continue

        app="${line%%:*}"
        if [[ "$line" == *:* ]]; then
            pkg="${line#*:}"
        else
            pkg="$app"
        fi

        desc="$(
            apk info --installed -d "$pkg" 2>/dev/null |
            sed -n '2p'
        )"
        [ -n "$desc" ] || desc="(description unavailable)"

        printf "  %-18s %s\n" "$app" "$desc"
        count=$((count + 1))
    done < "$list"

    printf "\n%d application(s) available.\n" "$count"
}

cmd="$(basename "$0")"
if [ "$cmd" = "kiosk" ]; then
    install
    exit 0
fi

crt_state="$HOME/.local/state/idun/crt"

if [ -r "$crt_state" ] && [ "$(cat "$crt_state")" = "1" ]; then
    export ENABLE_VKBASALT=1
else
    export ENABLE_VKBASALT=0
fi

target="/usr/bin/$cmd"
launcher=()

case "$cmd" in
	xterm)
		target="/usr/bin/kitty"
		;;
		
    vice)
        export SDL_VIDEO_DRIVER=wayland
        ;;

    thor)
        target="/usr/bin/kitty"
        launcher=(-e /usr/bin/yazi)
        ;;

    ocp)
    	target="/usr/bin/kitty"
    	launcher=(-e /usr/bin/ocp)
    	;;
esac

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
have_wayland=0

if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$runtime/$WAYLAND_DISPLAY" ]; then
    have_wayland=1
else
    for s in "$runtime"/wayland-*; do
        [ -S "$s" ] || continue
        export WAYLAND_DISPLAY="$(basename "$s")"
        have_wayland=1
        break
    done
fi

launch() {
	export LANG=C.UTF-8
    if [ "$have_wayland" -eq 1 ]; then
        setsid -c "$target" "${launcher[@]}" "$@" \
            >/dev/null 2>&1 </dev/null
    else
        cage -m last -s -d -- "$target" "${launcher[@]}" "$@" \
            >/dev/null 2>&1 </dev/null &
    fi
}

launch "$@"
exit 0
