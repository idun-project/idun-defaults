#!/bin/bash

# ---------------------------------------------------------
# Global Configuration & Initialization
# ---------------------------------------------------------
KIOSK_LIST="/usr/share/idun/kiosk.lst"
KIOSK_CONFIGS="/usr/share/idun/kiosk_conf.tar.zst"
BINDIR="$HOME/.local/bin"

# Determine the package manager
if command -v apk >/dev/null 2>&1; then
    PKG_MGR="apk"
elif command -v pacman >/dev/null 2>&1; then
    PKG_MGR="pacman"
else
    PKG_MGR="unknown"
fi

# ---------------------------------------------------------
# Helper Functions
# ---------------------------------------------------------
ensure_kiosk_list() {
    [ -f "$KIOSK_LIST" ] && return 0

    echo "Initializing $KIOSK_LIST with default entries..."
    sudo mkdir -p "$(dirname "$KIOSK_LIST")"
    cat << 'EOF' | sudo tee "$KIOSK_LIST" >/dev/null
# [!]app[->command][:package]
# The "!" prefix means TUI app; so runs inside xterm instance.
# If command is omitted, then it matches the app.
# If package is omitted than it matches the command.
# All commands are assumed to be in /usr/bin/.
xterm->foot
!thor->yazi
syncterm
!ocp:opencubicplayer
vice:idun-vice
EOF
}

# Helper to parse [!]link[->command][:package] lines according to defaults:
# - link: Primary alias name (created in BINDIR)
# - command: Executable binary in /usr/bin/ (defaults to link if absent)
# - package: Package name for apk/pacman (defaults to command if absent)
parse_kiosk_line() {
    local raw_line="$1"
    tui=0
    link=""
    cmd_name=""
    pkg=""

    # Strip comments and surrounding whitespace
    raw_line="${raw_line%%#*}"
    raw_line="${raw_line%"${raw_line##*[![:space:]]}"}"
    raw_line="${raw_line#"${raw_line%%[![:space:]]*}"}"
    [ -n "$raw_line" ] || return 1

    # Check for TUI prefix
    if [[ "$raw_line" == "!"* ]]; then
        tui=1
        raw_line="${raw_line#!}"
    fi

    # Parse package component (part after :)
    if [[ "$raw_line" == *":"* ]]; then
        pkg="${raw_line#*:}"
        raw_line="${raw_line%%:*}"
    fi

    # Parse command component (part after ->)
    if [[ "$raw_line" == *"->"* ]]; then
        cmd_name="${raw_line#*->}"
        link="${raw_line%%->*}"
    else
        link="$raw_line"
        cmd_name="$link"
    fi

    # Fallback package to command name if omitted
    if [ -z "$pkg" ]; then
        pkg="$cmd_name"
    fi

    return 0
}

spawn() {
    if command -v systemd-run >/dev/null 2>&1; then
        systemd-run --user \
            --collect \
            --quiet \
            --same-dir \
            "$@"
    else
        setsid -c "$@" >/dev/null 2>&1 </dev/null &
    fi
}

display() {
    runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$runtime/$WAYLAND_DISPLAY" ]; then
        return 0
    else
        for s in "$runtime"/wayland-*; do
            [ -S "$s" ] || continue
            export WAYLAND_DISPLAY="$(basename "$s")"
            return 0
        done
        return 1
    fi
}

session() {
    # Fix needed for Qt5 programs like cool-retro-term
    export QT_QPA_PLATFORM=wayland

    if display; then
        spawn "$target" "${launcher[@]}" "$@"
    else
        cage -m last -d -s -- "$target" "${launcher[@]}" "$@" \
            >/dev/null 2>&1 </dev/null &
    fi
}

is_installed() {
    local check_pkg="$1"
    if [ "$PKG_MGR" = "apk" ]; then
        apk info -e "$check_pkg" >/dev/null 2>&1
    elif [ "$PKG_MGR" = "pacman" ]; then
        pacman -Qq "$check_pkg" >/dev/null 2>&1
    else
        return 1
    fi
}

# ---------------------------------------------------------
# Core Kiosk Functions
# ---------------------------------------------------------
app() {
    local raw_entry="$1"
    
    if [ -z "$raw_entry" ]; then
        echo "Error: No package or entry provided."
        return 1
    fi

    if [ "$PKG_MGR" = "unknown" ]; then
        echo "Error: No supported package manager (apk/pacman) found."
        return 1
    fi

    # Parse entry to isolate the target package and link
    parse_kiosk_line "$raw_entry" || return 1
    local entry_link="$link"
    local entry_pkg="$pkg"

    # Check and install package
    if ! is_installed "$entry_pkg"; then
        echo "Installing $entry_pkg..."
        if [ "$PKG_MGR" = "apk" ]; then
            sudo apk add "$entry_pkg"
        elif [ "$PKG_MGR" = "pacman" ]; then
            sudo pacman -S --noconfirm "$entry_pkg"
        fi
        
        if [ $? -ne 0 ]; then
            echo "Error: Failed to install $entry_pkg."
            return 1
        fi
    else
        echo "Package '$entry_pkg' is already installed."
    fi

    # Add to kiosk.lst if link is not already present
    if ! grep -Eq "^[[:space:]]*!?${entry_link}(->|:|[[:space:]]|$)" "$KIOSK_LIST" 2>/dev/null; then
        echo "Adding '$raw_entry' to $KIOSK_LIST..."
        echo "$raw_entry" | sudo tee -a "$KIOSK_LIST" >/dev/null
    else
        echo "Link '$entry_link' is already in the kiosk list."
    fi

    # Run normal install to link and print available apps
    install
}

remove() {
    local raw_app="$1"
    
    if [ -z "$raw_app" ]; then
        echo "Error: No app link provided to remove."
        return 1
    fi

    # Clean input down to target link name if formatted string was passed
    local target_link="${raw_app#!}"
    target_link="${target_link%%->*}"
    target_link="${target_link%%:*}"

    if grep -Eq "^[[:space:]]*!?${target_link}(->|:|[[:space:]]|$)" "$KIOSK_LIST" 2>/dev/null; then
        echo "Removing '$target_link' from $KIOSK_LIST..."
        sudo sed -i -E "/^[[:space:]]*!?${target_link}(->|:|[[:space:]]|$)/d" "$KIOSK_LIST"
    else
        echo "Link '$target_link' is not found in the kiosk list."
    fi

    # Refresh symlinks and display list
    install
}

install() {
    local self
    local count=0

    self="$(readlink -f "$0")"
    mkdir -p "$BINDIR"
    declare -A wanted

    #
    # Part 1: Synchronize desired links
    #
    while IFS= read -r line || [ -n "$line" ]; do
        parse_kiosk_line "$line" || continue
        wanted["$link"]=1
    done < "$KIOSK_LIST"

    #
    # Part 2: Remove obsolete kiosk-managed links
    #
    for link_path in "$BINDIR"/*; do
        [ -L "$link_path" ] || continue

        target_file="$(readlink -f "$link_path")"
        [ "$target_file" = "$self" ] || continue

        app_name="$(basename "$link_path")"
        if [ -z "${wanted[$app_name]}" ]; then
            rm -f "$link_path"
        fi
    done

    #
    # Part 3: Install application configuration files
    #
    if [ "$replace_config" -eq 1 ]; then
        echo "Over-writing configuration for kiosk apps."
        tar --zstd -xf "$KIOSK_CONFIGS" -C ~/.config
    else
        tar --skip-old-files --zstd -xf "$KIOSK_CONFIGS" -C ~/.config
    fi

    #
    # Part 4: Display/link available applications
    #
    printf "\nAvailable kiosk applications:\n\n"
    if [ "$PKG_MGR" = "unknown" ]; then
        echo "Warning: No supported package manager (apk/pacman) found."
    fi

    while IFS= read -r line || [ -n "$line" ]; do
        parse_kiosk_line "$line" || continue

        # Fetch description based on the active package manager using resolved $pkg
        desc=""
        if [ "$PKG_MGR" = "apk" ]; then
            desc="$(apk info --installed -d "$pkg" 2>/dev/null | sed -n '2p')"
        elif [ "$PKG_MGR" = "pacman" ]; then
            desc="$(pacman -Qi "$pkg" 2>/dev/null | sed -n 's/^Description[[:space:]]*:[[:space:]]*//p')"
        fi
        
        if [ -n "$desc" ]; then
            ln -snf "$self" "$BINDIR/$link"
            # Wrap at 68 chars on word boundaries, indenting subsequent lines by 12
            formatted_desc=$(printf "%s\n" "$desc" | fold -s -w 68 | sed '2,$s/^/            /')
            printf " %-10s %s\n" "$link" "$formatted_desc"
            count=$((count + 1))
        fi
    done < "$KIOSK_LIST"

    printf "\n%d application(s) available.\n" "$count"
}

# ---------------------------------------------------------
# Execution Entry Point
# ---------------------------------------------------------
ensure_kiosk_list

cmd="$(basename "$0")"
if [ "$cmd" = "kiosk" ]; then
    replace_config=0
    
    # Sub-command routing
    if [ "$1" = "help" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
        echo "Usage: kiosk [SUB-COMMAND] [OPTIONS]"
        echo ""
        echo "Sub-commands:"
        echo "  add/app <package>          Install and add a standard package to the kiosk"
        echo "  add xterm <app>            Add a TUI application"
        echo "  add <package> cmd <app>    Add a package with a specific executable"
        echo "  add <package> alias <app>  Create an alias name for a command/package"
        echo "  remove <app>               Remove an application link from the kiosk list"
        echo "  help                       Show this help message"
        echo ""
        echo "Options:"
        echo "  --replace-config           Overwrite configuration files for kiosk apps"
        exit 0
    elif [ "$1" = "app" ] || [ "$1" = "add" ]; then
        if [ "$2" = "xterm" ] && [ -n "$3" ]; then
            app "!$3"
        elif [ "$3" = "cmd" ] && [ -n "$4" ]; then
            app "$4:$2"
        elif [ "$3" = "alias" ] && [ -n "$4" ]; then
            app "$4->$2"
        else
            app "$2"
        fi
        exit 0
    elif [ "$1" = "remove" ]; then
        remove "$2"
        exit 0
    fi

    # Loop through all arguments passed to the script for standard install behavior
    for arg in "$@"; do
        if [ "$arg" = "--replace-config" ]; then
            replace_config=1
            break
        fi
    done

    install
    exit 0
fi

# Fix locale setting for utf-8
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

xterm_binary=/usr/bin/foot
target="/usr/bin/$cmd"
launcher=()

# Search kiosk.lst for an entry matching the invoked command symlink name
matched_line=""
if [ -f "$KIOSK_LIST" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        if parse_kiosk_line "$line"; then
            if [ "$link" = "$cmd" ]; then
                matched_line="$line"
                break
            fi
        fi
    done < "$KIOSK_LIST"
fi

if [ -n "$matched_line" ]; then
    parse_kiosk_line "$matched_line"
    if [ "$tui" -eq 1 ]; then
        # Check if we are already in a capable terminal (e.g., via SSH or a local terminal)
        if [[ "$TERM" == *"256color"* || "$TERM" == *"kitty"* || "$TERM" == "foot"* || "$TERM" == *"alacritty"* || "$TERM" == *"wezterm"* || "$TERM" == *"ghostty"* ]]; then
            # Take over the current capable terminal session
            exec /usr/bin/"$cmd_name" "$@"
        else
            # Fallback to wrapping the TUI in the Wayland kiosk xterm
            target="$xterm_binary"
            launcher=(-e "/usr/bin/$cmd_name")
        fi
    else
        target="/usr/bin/$cmd_name"
    fi
elif [ "$cmd" = "xterm" ]; then
    target="$xterm_binary"
fi

# The script only reaches here if 'exec' was not called above
session "$@"
exit 0
